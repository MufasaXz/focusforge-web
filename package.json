{
  "name": "focusforge-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/browser-check.mjs && node scripts/demo-check.mjs && node scripts/clock-check.mjs",
    "test": "npm run build && node --test tests/site.test.mjs",
    "test:cleanup": "node --test tests/account-cleanup.test.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.51.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
